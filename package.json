{
  "name": "tabsboard",
  "version": "2.0.0",
  "private": true,
  "description": "A new tab page for people with too many tabs (Chrome MV3 + Firefox MV2).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && node scripts/lint-bundle.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "python3 tests/e2e/run_all.py",
    "sync": "node scripts/sync.js --write",
    "check:sync": "node scripts/sync.js",
    "build": "node scripts/build.js",
    "lint:ext": "node scripts/lint-ext.js",
    "check": "npm run check:sync && npm run lint && npm test"
  },
  "devDependencies": {
    "dexie": "4.0.11",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
